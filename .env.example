# ===== GROQ =====
GROQ_API_KEY=gsk_tu_api_key_aqui
GROQ_MODEL=llama-3.3-70b-versatile

# ===== METATRADER 5 =====
# Si MT5 ya esta abierto y logueado, puedes dejar estos vacios.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Ruta al terminal (opcional, solo si no lo detecta solo)
MT5_PATH=

# ===== TRADING =====
# Simbolos separados por coma (verifica los nombres exactos en tu broker)
SYMBOLS=EURUSD,GBPUSD,XAUUSD
TIMEFRAME=M5
# Segundos entre cada ciclo de analisis
LOOP_SECONDS=60

# ===== RIESGO =====
# % del equity arriesgado por trade (0.5 = 0.5%)
RISK_PER_TRADE_PCT=0.5
MAX_OPEN_POSITIONS=3
# Si la perdida del dia supera este % del balance, el bot se pausa solo
MAX_DAILY_LOSS_PCT=3.0
# Confianza minima (0-100) que la IA debe tener para abrir un trade
MIN_CONFIDENCE=65

# true = manda ordenes reales. false = solo analiza y muestra en la UI
TRADING_ENABLED=true

# ===== UI =====
UI_PORT=5000
