# ===== IA =====
# "groq" (nube, requiere API key) o "ollama" (local, sin limites de tokens)
AI_PROVIDER=groq

# --- Groq (solo si AI_PROVIDER=groq) ---
GROQ_API_KEY=gsk_tu_api_key_aqui
GROQ_MODEL=llama-3.3-70b-versatile

# --- Ollama (solo si AI_PROVIDER=ollama) ---
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:14b

# ===== METATRADER 5 =====
# Si MT5 ya esta abierto y logueado, puedes dejar estos vacios.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Ruta al terminal (opcional, solo si no lo detecta solo)
MT5_PATH=

# ===== TRADING =====
# Simbolos separados por coma (verifica los nombres exactos en tu broker)
SYMBOLS=EURUSD,GBPUSD,XAUUSD
TIMEFRAME=M5
# Segundos entre cada ciclo de analisis
LOOP_SECONDS=60

# ===== RIESGO =====
# % del equity arriesgado por trade (0.5 = 0.5%)
RISK_PER_TRADE_PCT=0.5
MAX_OPEN_POSITIONS=3
# Si la perdida del dia supera este % del balance, el bot se pausa solo
MAX_DAILY_LOSS_PCT=3.0
# Confianza minima (0-100) que la IA debe tener para abrir un trade
MIN_CONFIDENCE=65

# ===== FILTROS DUROS (no dependen de la IA) =====
# No abrir trades si el spread supera este multiplo del ATR (mercado caro/iliquido)
MAX_SPREAD_ATR_RATIO=0.25
# Tras N perdidas seguidas en un simbolo, pausa de entradas en ese simbolo (0 = off)
COOLDOWN_AFTER_LOSSES=2
COOLDOWN_MINUTES=45
# Maximo de posiciones apostando en la misma direccion de una misma divisa
# (p.ej. EURUSD largo + GBPUSD largo = 2 apuestas contra USD)
MAX_CURRENCY_EXPOSURE=2
# Cada cuantos trades cerrados la IA consolida sus lecciones en reglas duraderas
CONSOLIDATE_EVERY=10

# ===== NOTICIAS EN VIVO =====
# RSS de ~15 fuentes (forex, mercados, mundo, bancos centrales, cripto,
# materias primas) + calendario economico. La IA las ve en cada decision.
NEWS_ENABLED=true
# Cada cuantos segundos se refrescan los titulares
NEWS_REFRESH_SECONDS=120
# Filtro duro: no abrir trades N min ANTES / DESPUES de un dato de ALTO
# impacto de las divisas del simbolo (NFP, CPI, tipos...). 0 y 0 = off.
NEWS_BLOCK_BEFORE_MIN=15
NEWS_BLOCK_AFTER_MIN=10
# Feeds RSS extra tuyos, separados por coma (opcional)
NEWS_EXTRA_FEEDS=

# true = manda ordenes reales. false = solo analiza y muestra en la UI
TRADING_ENABLED=true

# ===== UI =====
UI_PORT=5000
# 127.0.0.1 = solo esta maquina (uso local).
# 0.0.0.0   = accesible desde fuera (VPS). En ese caso UI_PASSWORD es OBLIGATORIA.
UI_HOST=127.0.0.1
# Contrasena del panel web. Vacia = sin login (solo permitido en local).
UI_PASSWORD=
# UI_SECRET_KEY se genera y guarda sola; no hace falta tocarla.
